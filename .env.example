# Neon Postgres (Console → Connect → pooled connection string)
DATABASE_URL=

# Better Auth: random secret (`openssl rand -base64 32`) and the public URL of the site
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Who may sign up at /registreren (comma-separated). Empty = nobody.
SIGNUP_ALLOWED_EMAILS=

# OpenAI — server only, never prefix with NEXT_PUBLIC_
OPENAI_API_KEY=

# A vision-capable model name, e.g. from https://platform.openai.com/docs/models
OPENAI_MODEL=
# Optional: a cheaper/faster model for the image-selection pass (falls back to OPENAI_MODEL)
OPENAI_MODEL_FAST=
