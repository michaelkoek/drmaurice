# Neon Postgres (Console → Connect → pooled connection string)
DATABASE_URL=

# Better Auth: random secret (`openssl rand -base64 32`) and the public URL of the site
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Sign-up at /registreren is open; access needs a €5 payment, except for these emails (comma-separated)
FREE_ACCESS_EMAILS=
# May open /beheer (feedback, payments). Admins also get free access.
ADMIN_EMAILS=

# Stripe — server only. Use a restricted key (rk_…) with only "Checkout Sessions: Write".
# Sandbox key locally, live key only in Vercel Production.
STRIPE_SECRET_KEY=
# Price of the one-time €5 product (Dashboard → Product catalogue), starts with price_
STRIPE_PRICE_ID=
# Signing secret of the webhook endpoint (or from `stripe listen` locally), starts with whsec_
STRIPE_WEBHOOK_SECRET=

# OpenAI — server only, never prefix with NEXT_PUBLIC_
OPENAI_API_KEY=
# Models are set per task in TASKS (lib/openai.ts), not here.
# Dev only: save each upload to .eval/inputs for `npm run eval:models`
# OPENAI_EVAL_DUMP=1
