# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — server only, never prefix with NEXT_PUBLIC_
OPENAI_API_KEY=

# A vision-capable model name, e.g. from https://platform.openai.com/docs/models
OPENAI_MODEL=
# Optional: a cheaper/faster model for the image-selection pass (falls back to OPENAI_MODEL)
OPENAI_MODEL_FAST=

# Public URL of the site, used in auth emails (e.g. https://drmauricecards.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
