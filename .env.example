# Neon Postgres (Console → Connect → pooled connection string)
DATABASE_URL=

# Better Auth: random secret (`openssl rand -base64 32`) and the public URL of the site
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Who may sign up at /registreren (comma-separated). Empty = nobody.
SIGNUP_ALLOWED_EMAILS=

# OpenAI — server only, never prefix with NEXT_PUBLIC_
OPENAI_API_KEY=
# Models are set per task in TASKS (lib/openai.ts), not here.
# Dev only: save each upload to .eval/inputs for `npm run eval:models`
# OPENAI_EVAL_DUMP=1
